# Application
NODE_ENV=development
PORT=3000

# Simulation execution (11_インフラストラクチャ設計.md「設定項目」)
# ワーカー内戦闘実行の期限(ms)。超過すると504 EXECUTION_TIMEOUTを返す。
SIMULATION_TIMEOUT_MS=30000
# Worker Poolの待機タスク上限。満杯時は503 CAPACITY_EXCEEDEDを返す。
WORKER_MAX_QUEUE=100
# Worker Threadの本数。未設定だとPiscinaがos.availableParallelism()から決めるが、
# これはhostのCPU数でありcontainerのCPU limitではない。配備時は割り当てCPUに
# 合わせて明示する(production: 1/1、docs/運用手順.md「Cloud Run配備構成」)。
# WORKER_MIN_THREADS=1
# WORKER_MAX_THREADS=1

# SimulationExecutionGuard (11_インフラストラクチャ設計.md「SimulationExecutionGuard」)
# 上限超過は503 EXECUTION_LIMIT_EXCEEDEDを返す。未設定時はコード既定値。
# 確定値と実測の根拠はdocs/運用手順.md「確定の根拠(REL-005の実測値)」。
SIMULATION_MAX_EVENTS=1000000
SIMULATION_MAX_PASSIVE_DEPTH=8
SIMULATION_MAX_EFFECTS_PER_SCOPE=100
SIMULATION_MAX_EFFECT_RUNTIME_COUNTER_DEPTH=10

# Graceful Shutdown (11_インフラストラクチャ設計.md「Graceful Shutdown」)
# SIGTERM/SIGINT受信後、実行中タスクを待つ上限(ms)。超過分は強制キャンセルする。
SHUTDOWN_GRACE_MS=30000

# Logging
LOG_LEVEL=info

# CORS (11_インフラストラクチャ設計.md「CORS」)
# GitHub Pages UIなどbrowserからのcross-origin requestを許可するorigin。
# comma区切り・完全一致のみ。schemeとhostだけを持つ絶対origin（path/query/
# fragment/userinfo/wildcard/重複は起動エラー）。未設定時は全origin拒否。
# 本番: CORS_ALLOWED_ORIGINS=https://komei0727.github.io
CORS_ALLOWED_ORIGINS=http://localhost:5173
