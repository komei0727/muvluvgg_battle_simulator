node_modules/
dist/
coverage/

.env
.env.*
!.env.example

mise.local.toml
mise.local.lock

AGENTS.md

raw/

# .claude/ is user-local (often ignored via a global gitignore), but the
# muvluvgg-implement-issue skill is a project asset: its quality-gate wrapper
# must ship with the repo so the gate definition stays unified (Issue #310).
# These negations take precedence over a global `.claude/` ignore.
!.claude/
.claude/*
!.claude/skills/
.claude/skills/*
!.claude/skills/muvluvgg-implement-issue/

apps/ui/playwright-report/
apps/ui/test-results/

# tools/ (uv workspace of Python labs). These live in the root .gitignore
# rather than a nested one because Prettier's default ignore-path reads only
# the root .gitignore — a nested file would leave the virtualenv's bundled
# .md/.json/.css inside the repo-wide `format:check`.
.venv/
__pycache__/
.pytest_cache/
.ruff_cache/
tools/exercise-lab/reports/
# Personal formation / match configs. Only the committed samples are tracked, so
# that experimenting in place never turns into an accidental commit.
tools/exercise-lab/configs/*.yaml
!tools/exercise-lab/configs/*.example.yaml
tools/battle-lab/configs/*.yaml
!tools/battle-lab/configs/*.example.yaml
tools/total-war-lab/configs/*.yaml
!tools/total-war-lab/configs/*.example.yaml
# Personal formation library (`exercise-lab formations`). Same reasoning as above;
# only personal entries live here, so the committed samples must not depend on them.
tools/exercise-lab/configs/formations/
# 各ラボの `schema` コマンドの生成物（tools ルートへ集約）と、UIから書き出したドラフト・
# 手持ちデータ。どれも Catalog / 手元の編成に紐づく生成物なので追跡しない。
tools/.schema/
tools/exercise-lab/local_storage/*
tools/battle-lab/local_storage/
tools/total-war-lab/local_storage/
# 個人の入力データ（UIから取り出したドラフト・育成JSON、import-draftの編成YAML）と
# 評価実行の保存先（SQLite・manifest）。どちらも個人データ・生成物なので追跡しない。
tools/data/

# Character art thumbnails generated by apps/ui/scripts/sync-character-images.mjs.
# Kept local-only for now (unresolved licensing for official character art);
# un-ignore these to publish once that's settled.
apps/ui/src/assets/units/
apps/ui/src/assets/memories/

# scripts/cloud-run/07-configure-access-keys.sh へ渡すアクセスキーのファイル
# (ACCESS_KEYS_FILE)。秘密値なので、repository内に置いても追跡しない。
api-access-key*.txt
