node_modules/
dist/
coverage/

.env
.env.*
!.env.example

mise.local.toml
mise.local.lock

AGENTS.md

raw/

# .claude/ is user-local (often ignored via a global gitignore), but the
# muvluvgg-implement-issue skill is a project asset: its quality-gate wrapper
# must ship with the repo so the gate definition stays unified (Issue #310).
# These negations take precedence over a global `.claude/` ignore.
!.claude/
.claude/*
!.claude/skills/
.claude/skills/*
!.claude/skills/muvluvgg-implement-issue/

apps/ui/playwright-report/
apps/ui/test-results/

# tools/exercise-lab (uv-managed Python). These live in the root .gitignore
# rather than a nested one because Prettier's default ignore-path reads only
# the root .gitignore — a nested file would leave the virtualenv's bundled
# .md/.json/.css inside the repo-wide `format:check`.
.venv/
__pycache__/
.pytest_cache/
.ruff_cache/
tools/exercise-lab/reports/
# Personal formation configs. Only the committed sample is tracked, so that
# experimenting in place never turns into an accidental commit.
tools/exercise-lab/configs/*.yaml
!tools/exercise-lab/configs/*.example.yaml
# `lab schema` の生成物と、UIから書き出した演習ドラフト。どちらも Catalog / 手元の
# 編成に紐づく生成物なので追跡しない。
tools/exercise-lab/.schema/
tools/exercise-lab/local_storage/*

# Character art thumbnails generated by apps/ui/scripts/sync-character-images.mjs.
# Kept local-only for now (unresolved licensing for official character art);
# un-ignore these to publish once that's settled.
apps/ui/src/assets/units/
apps/ui/src/assets/memories/
